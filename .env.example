# Copy to .env and fill in. .env is gitignored.

# --- Neo4j connection ---
# Inside docker-compose the host is the service name `neo4j`; from the host machine use localhost.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only
NEO4J_DATABASE=neo4j

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API. The Next.js web UI runs on :3000.
# Use "*" to allow any origin (development only — it also disables credentialed requests).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Data paths (relative to repo root) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_MANUAL_DIR=data/manual

# --- Entity resolution tuning ---
# Fuzzy scores at/above this threshold become human-review CANDIDATES.
# They are NEVER auto-accepted as matches. See docs/schema.md.
FUZZY_CANDIDATE_THRESHOLD=88
FUZZY_NEGATIVE_BLOCKLIST=data/manual/fuzzy_negative_blocklist.csv

# --- Interaction coverage and combination packs ---
# Both default to these paths; set here so it is obvious which dataset is being served.
# Both fail CLOSED when the file is missing: no pair can be reported as checked, and combination
# pack names do not resolve. data/demo/ is a test fixture and must not be pointed at here.
COVERAGE_MANIFEST=data/processed/ddinter_coverage.json
COMBINATIONS_FILE=data/processed/combinations.csv
